# Copy to .env and adjust. All MB_* names map to src/mindbridge/config.py.
MB_ENV=dev
MB_JWT_SECRET=change-me   # must be 32+ chars when MB_ENV=prod
MB_REQUIRE_AUTH=true
MB_EMBEDDING_BACKEND=auto          # auto | lsa | sbert

# Generation. Leave as "none" to run with extractive answers only.
MB_LLM_PROVIDER=none               # none | anthropic | openai | ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MB_OLLAMA_URL=http://localhost:11434

# Optional LLM second opinion on borderline crisis messages
MB_SAFETY_LLM_CHECK=false
